# העתיקי קובץ זה ל-.env והכניסי את הערכים שלך
GEMINI_API_KEY=הכניסי_את_המפתח_כאן

# ===== מודל =====
# חייב להיות מודל *הבנת* תמונות ולא *יצירת* תמונות!
# gemini-3-pro-image הוא מודל ליצירת תמונות — הוא ימציא טקסט במקום לתמלל.
GEMINI_MODEL=gemini-3.1-pro-preview

# ===== הגדרות בקשה (Gemini 3) =====
# תקציב טוקני פלט. חשוב: טוקני החשיבה נספרים בתוך התקציב הזה,
# ולכן תקציב קטן גורם לתמלול שנקטע באמצע העמוד.
# 65536 הוא המקסימום של gemini-3.1-pro.
# התקציב הוא תקרה ולא הזמנה — משלמים רק על מה שנוצר בפועל,
# ולכן תקרה גבוהה לא מייקרת כלום.
MAX_OUTPUT_TOKENS=65536

# רמת חשיבה: minimal | low | medium | high
# לכתב יד קשה מאוד — high נותן תמלול נאמן יותר (נבדק בפועל).
# לכתב יד קריא — low חוסך כסף.
THINKING_LEVEL=high

# רזולוציית התמונה שנשלחת למודל: low | medium | high
MEDIA_RESOLUTION=high

# ===== Few-Shot =====
# כבוי כברירת מחדל! דוגמאות ברמת עמוד שלם מזהמות את ההקשר
# וגורמות למודל להשלים תוכן מהן במקום לתמלל את התמונה.
USE_FEW_SHOT=false
MAX_FEW_SHOT_SAMPLES=5

# ===== תמלול =====
CONFIDENCE_THRESHOLD=0.80
LANGUAGE_MODE=auto
RENDER_DPI=300

# ===== תמחור (לדיווח עלות בלבד, בדולר למיליון טוקנים) =====
# לעדכון: https://ai.google.dev/gemini-api/docs/pricing
PRICE_INPUT_PER_M=2.0
PRICE_OUTPUT_PER_M=12.0

# ===== פלט ולוגים =====
OUTPUT_MERGE=true
LOG_LEVEL=INFO
WEB_PORT=5000
